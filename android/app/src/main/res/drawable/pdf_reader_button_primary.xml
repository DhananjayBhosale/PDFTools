<?xml version="1.0" encoding="utf-8"?>
<!-- Filled accent with a real ripple, so the press is felt immediately. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pdf_reader_on_accent">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pdf_reader_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
